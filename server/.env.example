DATABASE_URL=postgres://wayfarer_app:wayfarer_dev_pw@127.0.0.1:5432/wayfarer_dev
JWT_SECRET=change-me-in-production
PORT=3001

# Without this, email.js silently no-ops (logs and returns) instead of
# sending anything -- welcome emails, the capture-email gate email, and the
# monthly newsletter all depend on it. Get a key from resend.com. Note: until
# you verify a real sending domain in Resend, the "onboarding@resend.dev"
# sender it defaults to can only deliver to the email address your Resend
# account itself is registered under -- not to arbitrary recipients.
RESEND_API_KEY=

# Public URL of the deployed app (e.g. https://voya.onrender.com). Used to
# build real links in emails (newsletter unsubscribe, capture-email welcome).
APP_URL=

# Shared password for /admin.html (the moderation dashboard). Anyone who
# knows this can edit/archive listings and resolve reports -- keep it secret,
# don't reuse it elsewhere, and set a real one in production.
ADMIN_PASSWORD=change-me-in-production
